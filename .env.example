# Public Supabase configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production URL used in redirects, metadata, and emails
NEXT_PUBLIC_APP_URL=https://naetwork.dk
APP_BASE_URL=https://naetwork.dk
# Actual data controller and complete Danish business details. Use e.g. "CVR 12345678" format; placeholders fail release preflight.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=

# Resend
# Sender must be verified in Resend before production email works.
RESEND_API_KEY=
EMAIL_FROM=Naetwork <no-reply@naetwork.dk>
SUPPORT_EMAIL=kontakt@naetwork.dk
NEXT_PUBLIC_SUPPORT_EMAIL=kontakt@naetwork.dk
