{
  "name": "naetwork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "contentcheck": "node scripts/content-audit.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-small --project=mobile-standard",
    "check": "pnpm contentcheck && pnpm typecheck && pnpm build",
    "check:release": "pnpm preflight && pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.2.7",
    "@fontsource/gfs-didot": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "2.49.1",
    "lucide-react": "0.469.0",
    "next": "^15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.10.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
